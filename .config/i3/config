# i3 wm core configuration
# Nord Theme - Simple, clean, and glassmorphic
# Targets OpenSUSE

# Set modifier key (Mod4 = Windows/Super key)
set $mod Mod4

# Font for window titles, also used by bar if not overridden
font pango:JetBrains Mono 10

# Configure gaps
gaps inner 10
gaps outer 6
smart_gaps on
smart_borders on

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Border style
default_border pixel 2
default_floating_border normal
hide_edge_borders smart

# --- Autostart Applications ---
# Compositor (picom) configured for dual_kawase blur & transparency
exec_always --no-startup-id picom -b --config ~/.config/picom/picom.conf

# Status bar launcher
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Notification Daemon
exec_always --no-startup-id dunst

# Japanese Input Method (Fcitx5)
exec_always --no-startup-id fcitx5 -d --replace

# Wallpaper (Statically set a solid Nord background or restore wallpaper)
exec_always --no-startup-id xsetroot -solid "#2e3440"

# Polkit agent for authentication
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Network Manager applet
exec --no-startup-id nm-applet

# --- Keybindings ---

# Start a terminal (kitty)
bindsym $mod+Return exec kitty

# Kill focused window
bindsym $mod+q kill

# Application Launcher (rofi with glassmorphic layout)
bindsym $mod+d exec rofi -show drun -theme ~/.config/rofi/themes/launcher.rasi

# System Session Menu (rofi-based power menu)
bindsym $mod+Escape exec ~/.config/i3/scripts/sysmenu.sh

# Screen brightness controls (via brightness.sh script)
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/scripts/brightness.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/brightness.sh down

# Volume controls (via volume.sh script using pamixer/amixer)
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/volume.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/volume.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/scripts/volume.sh mute

# Media controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Screenshot (via screenshot.sh)
bindsym Print exec --no-startup-id ~/.config/i3/scripts/screenshot.sh full
bindsym Shift+Print exec --no-startup-id ~/.config/i3/scripts/screenshot.sh area

# Focus navigation (vi-style & arrow keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split orientation
bindsym $mod+b split h
bindsym $mod+v split v

# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Workspaces Definition
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload the configuration file
bindsym $mod+Shift+c reload
# Restart i3 inplace (preserves your layout/session)
bindsym $mod+Shift+r restart

# Resize mode
mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# --- Nord Theme Color Scheme Configuration ---
# Polar Night (backgrounds)
set $nord0 #2e3440
set $nord1 #3b4252
set $nord2 #434c5e
set $nord3 #4c566a
# Snow Storm (foregrounds/texts)
set $nord4 #d8dee9
set $nord5 #e5e9f0
set $nord6 #eceff4
# Frost (accent colors)
set $nord7 #8fbcbb
set $nord8 #88c0d0
set $nord9 #81a1c1
set $nord10 #5e81ac
# Aurora (alerts)
set $nord11 #bf616a

# Window borders & backgrounds
# class                 border  backgr. text    indicator child_border
client.focused          $nord8  $nord8  $nord0  $nord9    $nord8
client.focused_inactive $nord1  $nord1  $nord5  $nord1    $nord1
client.unfocused        $nord0  $nord0  $nord4  $nord0    $nord0
client.urgent           $nord11 $nord11 $nord0  $nord11   $nord11
client.placeholder      $nord2  $nord2  $nord5  $nord2    $nord2
client.background       $nord0
